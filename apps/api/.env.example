# Port d'écoute de l'API
PORT=4000

# Chemin du fichier de données (relatif au dossier apps/api)
DATA_FILE=../../starter-kit/donnees-logements-utilisateurs-kasa.csv

# Origine autorisée pour les appels du front
CORS_ORIGIN=http://localhost:3000

# Variables réservées à une évolution de l'API : non lues par le code actuel
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
